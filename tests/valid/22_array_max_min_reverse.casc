int maxOf(int a[], int n) {
    int m = a[0];
    for (int i = 1; i < n; i++) { if (a[i] > m) { m = a[i]; } }
    return m;
}
void reverse(int a[], int n) {
    for (int i = 0; i < n / 2; i++) {
        int t = a[i];
        a[i] = a[n - 1 - i];
        a[n - 1 - i] = t;
    }
}
int main() {
    int v[5] = {3, 9, 4, 1, 7};
    print(maxOf(v, 5));
    reverse(v, 5);
    for (int i = 0; i < 5; i++) { print(v[i]); }
    float f[3] = {0.5, 1.5, 2};
    f[1] += 1;
    print(f[1] * 2);
    return 0;
}
