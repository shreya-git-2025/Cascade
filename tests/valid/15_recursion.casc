int factorial(int n) {
    if (n <= 1) { return 1; }
    return n * factorial(n - 1);
}
int fib(int n) {
    if (n < 2) { return n; }
    return fib(n - 1) + fib(n - 2);
}
int main() {
    print(factorial(5));
    print(factorial(10));
    for (int i = 0; i < 10; i++) { print(fib(i)); }
    return 0;
}
