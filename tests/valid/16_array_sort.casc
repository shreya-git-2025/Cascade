void bubbleSort(int arr[], int n) {
    for (int i = 0; i < n - 1; i++) {
        for (int j = 0; j < n - i - 1; j++) {
            if (arr[j] > arr[j + 1]) {
                int tmp = arr[j];
                arr[j] = arr[j + 1];
                arr[j + 1] = tmp;
            }
        }
    }
}
int sum(int a[], int n) {
    int s = 0;
    for (int i = 0; i < n; i++) { s += a[i]; }
    return s;
}
int main() {
    int data[6] = {64, 34, 25, 12, 22, 11};
    bubbleSort(data, 6);
    for (int i = 0; i < 6; i++) { print(data[i]); }
    print(sum(data, 6));
    return 0;
}
