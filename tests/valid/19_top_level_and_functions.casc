// no main(): top-level statements run in order and may call functions
int square(int x) { return x * x; }
float half(int x) { return x / 2.0; }
int total = 0;
for (int i = 1; i <= 5; i++) { total += square(i); }
float h = half(total);
int values[4] = {10, 20, 30, 40};
values[2] = values[0] + values[3];
