// single-statement bodies need no braces, as in C
int fact(int n) {
    if (n <= 1) return 1;
    return n * fact(n - 1);
}
int total = 0;
for (int i = 1; i <= 5; i++)
    total += fact(i);
int k = 0;
while (k < 3)
    k++;
int sign = 0;
int v = 0 - 4;
if (v > 0) sign = 1; else if (v < 0) sign = 0 - 1; else sign = 0;
